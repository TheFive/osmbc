# OSMBC example Quadlet: daily database dump plus a copy of the editorial
# config, started by osmbc-backup.timer (which goes to
# ~/.config/systemd/user/, Quadlet doesn't read timers). See
# docs/container.md "Backup".

[Unit]
Description=OSMBC database backup
Requires=osmbc-db.service
After=osmbc-db.service

[Container]
ContainerName=osmbc-backup
# Same image as osmbc-db.container: pg_dump must not be older than the server.
Image=docker.io/library/postgres:18
Network=osmbc.network
# time in the file names; without it they are in UTC
Environment=TZ=Europe/Berlin
Secret=osmbc-db-password,type=env,target=PGPASSWORD
# The host user becomes the image's user postgres (uid 999), so the dumps
# in backup/ belong to the host user and the server backup can read them.
UserNS=keep-id:uid=999,gid=999
# Z: SELinux label for this container only; ignored without SELinux.
Volume=%h/osmbc/backup:/backup:Z
# Read-only, for the copy of the editorial config (z: shared label, the
# app container uses the folder too).
Volume=%h/osmbc/config:/config:ro,z
# The editorial config is kept by the editors on the server and not
# generated from anywhere, so it is backed up like the database: a copy
# with the same time stamp as the dump. (The technical config holds the
# secrets and is not copied; keep it where it is generated from.)
# The dump is in custom format (-Fc): compressed, restorable with
# pg_restore; written to a temporary name first, so a failed dump never
# looks like a good one. Both kept 14 days. In systemd units %% is a
# literal % and $$ a literal $ (else systemd puts in its own variables).
Exec=sh -c 'set -e; t=$$(date +%%Y-%%m-%%d_%%H%%M); if [ -f /config/config.editorial.yaml ]; then cp /config/config.editorial.yaml /backup/config.editorial-$$t.yaml; fi; f=/backup/osmbc-$$t.dump; pg_dump -h osmbc-db -U osmbc -Fc -f "$$f.part" osmbc; mv "$$f.part" "$$f"; find /backup -name "osmbc-*.dump" -mtime +14 -delete; find /backup -name "config.editorial-*.yaml" -mtime +14 -delete'

[Service]
# Run once and exit; no Restart and no RemainAfterExit (that would keep
# the job "started" and the timer could not start it again).
Type=oneshot
