extends layout

block additionalMenuRight  
  +langMenu(2)




block content
  
  div
    - var action = layout.htmlroot+"/article/searchandcreate";
    - if (!showCollect) action = layout.htmlroot+"/article/search";
      form(name="search", action=action, method="get")
        //- below md the search button sits next to the field
        div.row
          div.d-none.d-md-block.col-md-3
          div.col.col-md-6
            input#searchField(type="text",class="form-control",name ="search",value=search)
            if showCollect
              if (layout && layout.user && layout.user.access === "guest")
                p.osmbc-help-text(align="center") Please check your link for duplicates before submit it.
              else
                p.osmbc-help-text(align="center") Please check your link for duplicates before collect it.
          div.col-auto.col-md
            button#searchButton.btn.btn-lg.btn-primary(name="SearchNow" type="submit" disabled) Search


  .row
    if (foundArticles)
      - if (show === "all") show = foundArticles.length;
      - show = parseInt(show);

      if (foundArticles.length>0)
        p#articleCounter
          a(style={color:'Gray'}) 
            | Displaying #{(show>foundArticles.length)?foundArticles.length:show} of #{foundArticles.length} results.
          if (show < foundArticles.length)
            a(href=action + "?search=" + search + "&show=all&edit=showCollect")   Show All
        table.table.table-striped.table-sm.table-responsive
          thead
            tr 
              th="Blog"
              th="Title"
              th.d-none.d-sm-table-cell="Cat (EN)"
              if (layout && layout.user && layout.user.access === "guest")
                th.d-none.d-sm-table-cell="Submission"
              else
                th.d-none.d-sm-table-cell="Collection"
          tbody
            each  article,count in foundArticles
              if (count < show)
                tr(onclick=`$('.class_${article.id}').toggleClass('d-none');`)
                  td
                    i.fa.fa-caret-right(class="class_" + article.id)
                    i.fa.fa-caret-down.d-none(class="class_" + article.id)
                    a(href=layout.htmlroot+"/blog/" + article.blog)=article.blog
                  td
                    a(href=layout.htmlroot+"/article/" + article.id)=((article.title)?article.title:"No Title")
                  td.d-none.d-sm-table-cell=article.categoryEN
                  //- hidden on phones like its column header
                  td.pre.d-none.d-sm-table-cell=article.collection
                tr.d-none(class="class_" + article.id)
                  td
                  td(colspan=1)
                    |!{layout.md_renderInline(article["markdown"+layout.user.getLang(0)])}
                  td(colspan=2)
                    |!{layout.md_renderInline(article["markdown"+layout.user.getLang(1)])}

           
      else
        p(style={color:'Gray'}) 
            | No Articles found for search '#{search}'
        br
  .row
      if (foundArticles && showCollect)
        form(name="input",id="input" action=layout.htmlroot+"/article/create", method="post")
          h2 
            | Create Article 
          .row
            .col-md-6
              div 

                .row
                  .col-md-2
                    | Blog <br>
                  .col-md-10
                    +blogSelector
                .row
                  .col-md-2
                    | Category <br>
                  .col-md-10
                    select(id="categoryEN",name="categoryEN").form-control
                      for category in categories
                        option(value=category.EN ) #{category[layout.user.getLang(0)]} / #{category[layout.user.getLang(1)]}
          
     

            .col-md-6
              .row
                .col-md-7
                  p.osmbc-help-text(id="categoryDisplay")
                if firstDraftLang
                  //- with a First Draft: cancel at the start, saving with the
                  //- draft at the end (under the thumb)
                  .col-md-5.d-flex.flex-wrap.align-items-center.gap-2
                    a(href=layout.htmlroot+`/article/create` class="btn btn-outline-secondary" role="button") Cancel
                    button.btn.btn-lg.btn-outline-primary(id="OK")="Save link only"
                    button.btn.btn-lg.btn-primary(id="OKWithDraft" type="button" disabled)="Save with draft"
                else
                  .col-md-5.d-flex.align-items-center.gap-2
                    button.btn.btn-lg.btn-primary(id="OK")="OK"
                    a(href=layout.htmlroot+`/article/create` class="btn btn-outline-secondary" role="button") Cancel

          .row
            .col-md-1
              | Title <br>
            .col-md-11
              textarea.form-control(id = "title",name="title",placeholder="Please enter a title with at last 6 characters",rows=1, autofocus)=title
                 
          .row
            .col-md-1
              if (layout && layout.user && layout.user.access === "guest")
                | Submission <br>
              else
                | Collection <br>
            .col-md-11
              textarea.form-control(name="collection",rows=7,placeholder="put your link or info here")=collection
          if firstDraftLang
            //- the draft is made in the browser after loading (collect_draft.js),
            //- right away if the link is new, on request if it was found above
            .row#firstDraftArea(data-lang=firstDraftLang data-url=search.trim() data-auto=(foundArticles.length === 0) ? "true" : "false")
              .col-md-1
                | Draft #{firstDraftLang}
              .col-md-11
                div.d-flex.flex-wrap.align-items-center.gap-2.my-2
                  button.btn.btn-outline-primary.d-none#firstDraftStart(type="button")="First Draft (" + firstDraftLang + ")"
                  span.d-none#firstDraftWait
                    i.fa.fa-spinner.fa-spin
                    |  Claude is writing a first draft …
                  span.text-danger.d-none#firstDraftError
                textarea.form-control.d-none#firstDraftMarkdown(name="markdown" + firstDraftLang rows=3 lang=firstDraftLang spellcheck="true" data-fit-content disabled)
                div.card.card-body.my-2.d-none#firstDraftPreview

block append scripts_to_load                
  script(src=layout.htmlroot + "/javascripts/markdown-it.min.js?osmbc_v=" + layout.osmbc_version)
  if firstDraftLang
    script(src=layout.htmlroot + "/javascripts/collect_draft.js?osmbc_v=" + layout.osmbc_version)

block append scripts_to_execute
  script(nonce=cspNonce).
    window.onload = init;
    var placeholder = !{JSON.stringify(placeholder.categories)};
    var catArray = !{JSON.stringify(categories)};
    var noCategorie = "no categorie";
    if (catArray && catArray[0] && catArray[0].EN ) noCategorie = catArray[0].EN;


    function init() {


      categoryDisplay = document.getElementById("categoryDisplay");
      categoryEN = document.getElementById("categoryEN");
      if (categoryEN) categoryEN.onchange = onchangeCategory;
      okButton = document.getElementById("OK");
      if (okButton) okButton.addEventListener("click", function () { addSpinnerAndSubmit("#OK"); });
      searchButton = document.getElementById("searchButton")
      title = document.getElementById("title");
      searchField = document.getElementById("searchField")
      if (title) title.onchange = onchangeTitle;
      if (title) title.onkeyup = onchangeTitle;
      if (searchField) searchField.onchange = onchangeSearch;
      if (searchField) searchField.onkeyup = onchangeSearch;
      onchangeTitle();
      onchangeCategory();
      if (title) title.select();
    }

    function onchangeCategory() {
      if (!categoryEN) return;
      var c = categoryEN.value;
      if (c === noCategorie) {
        categoryEN.style.backgroundColor = "#FDC6CD";
      } else {
        categoryEN.style.backgroundColor = "";
      }
      if (placeholder[c]) {
         categoryDisplay.innerHTML = placeholder[c];    
        }
    }

    function onchangeTitle() {
      if (!title) return;
      var t = title.value.trim();
      okButton.disabled = true;
      if (t.length>5) {
        okButton.disabled=false;
      }
      // First Draft (collect_draft.js): saving with the draft needs a title
      // and a draft
      if (window.updateDraftSaveButton) window.updateDraftSaveButton();
    }
    function onchangeSearch() {
      if (!searchField) return;
      var s = searchField.value.trim();
      searchButton.disabled = true;
      if (s.length > 1) {
        searchButton.disabled = false;
      }
      
    }
   
 
           
                
