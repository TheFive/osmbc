extends ../layout

mixin blogReviewButtons(lang)
  if (!(blog["close"+lang])) && (lang !== null)
    - _rc = blog["reviewComment"+lang];
    if (_rc)
      .div
        if (blog["exported"+lang] || reviewInWP.indexOf(lang)<0)
          button.btn.btn-lg.btn-warning(id="closebutton" data-lang-status="closelang" data-lang=lang data-confirm=`Close ${blog.name} (${lang})?`) Close #{blog.name}(#{lang})
        else
          button.btn.btn-lg.btn-warning(id="didexport" data-lang-status="markexported" data-lang=lang data-confirm=`Mark ${blog.name} (${lang}) as exported?`) Did Export (#{lang})

      if (blog["exported"+lang])
        .div
          .alert.bg-danger.text-center.bold
            | <strong>Blog is exported, please do the last Review in WordPress</strong>

    else
      if blog.status != "open"
        button.btn.btn-lg.btn-primary(id="readyreview" data-lang-status="startreview" data-lang=lang) Set #{blog.name}(#{lang}) ready for review


//- Save and Cancel for the inline editors. onmousedown keeps the focus in
//- the text field, so Cancel does not trigger the save on leaving it.
//- Cancel at the start, Save at the end (under the thumb).
mixin inlineEditorButtons(id, column)
  div.d-flex.gap-2.my-2
    button.btn.btn-secondary(type="button" id=column + "inlineCancel" + id onmousedown="event.preventDefault();" onclick=`cancelInlineEditor(${id},'${column}');`) Cancel
    button.btn.btn-primary.ms-auto(type="button" id=column + "inlineSave" + id onmousedown="event.preventDefault();" onclick=`saveInlineEditor(${id},'${column}',true);`) Save

block append scripts_to_load
  script(src=layout.htmlroot + "/javascripts/markdown-it.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/markdown-it-emoji.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/markdown-it-sup.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/markdown-it-imsize.min.js?osmbc_v=" + layout.osmbc_version)
  
block append scripts_to_execute
  script(nonce=cspNonce).
    
    
    emojiShortcut = JSON.parse(decodeURIComponent(window.atob(`!{btoa(encodeURIComponent(JSON.stringify((languageFlags) ? languageFlags.shortcut : {})))}`)));
    emojiList =     JSON.parse(decodeURIComponent(window.atob(`!{btoa(encodeURIComponent(JSON.stringify((languageFlags) ? languageFlags.emoji : {})))}`)));  
    
     

    var openEditor = null;

    // a tap on an article text opens its inline editor (or closes the open
    // one); links in the text do not navigate
    $(document).on("click", "[data-inline-editor]", function (event) {
      event.preventDefault();
      if (!openEditor) {
        openEditor = document.getElementById(this.dataset.inlineEditor);
        openEditor.classList.toggle("d-none");
        fitToContentIn(openEditor);
      } else {
        openEditor.classList.toggle("d-none");
        openEditor = null;
      }
    });

    window.onload = function () {
      window.mdRender = window.markdownit();
      
      window.mdRender.use(window.markdownitEmoji, { defs: window.emojiList, shortcuts: window.emojiShortcut });
      window.mdRender.use(window.markdownitSup);
      window.mdRender.use(window["markdown-it-imsize.js"]);

      $(".preview").change(highlightWrongLinks);
      highlightWrongLinks(window);


      if (typeof(Storage) !== "undefined") {
        if (window.sessionStorage.blogUrl !== window.location.href) return;
        var x = window.sessionStorage.blogX;
        var y = window.sessionStorage.blogY;
        window.scrollTo(x, y);
      }
    }



    window.onbeforeunload = function (event) {
      // store the scroll Position in the local Store
      s = {x: window.scrollX, y: window.scrollY};

      if (typeof(Storage) !== "undefined") {

        window.sessionStorage.blogUrl = window.location.href;
        window.sessionStorage.blogX = s.x;
        window.sessionStorage.blogY = s.y;
      }
    };



    // Inline editors save in the background, without reloading the page.
    // Leaving the text field saves (desktop habit), Save also closes the
    // editor, Cancel goes back to the last saved text.
    var inlineSaves = {};

    function onLeaveText(id,column) {
      saveInlineEditor(id, column, false);
    }

    function inlineStatus(id, column, text, cls) {
      var editor = document.getElementById(column + "div" + id);
      var status = document.getElementById(column + "saveStatus" + id);
      if (!status) {
        status = document.createElement("span");
        status.id = column + "saveStatus" + id;
        editor.insertAdjacentElement("afterend", status);
      }
      status.className = "badge " + cls;
      status.textContent = text;
      if (cls === "text-bg-success") {
        setTimeout(function () { if (status.textContent === text) status.className = "d-none"; }, 4000);
      }
    }

    function closeInlineEditor(id, column) {
      var editor = document.getElementById(column + "div" + id);
      editor.classList.add("d-none");
      if (openEditor === editor) openEditor = null;
    }

    function saveInlineEditor(id, column, close) {
      if (!column) column = "";
      var key = column + id;
      if (inlineSaves[key]) return inlineSaves[key].then(function () { return saveInlineEditor(id, column, close); });
      var form = document.getElementById(column + "EditArticle" + id);
      var oldField = document.getElementById(column + "oldMarkdown" + id);
      var field = document.getElementById(column + "markdown" + id);
      if (oldField.value === field.value) {
        if (close) closeInlineEditor(id, column);
        return Promise.resolve();
      }
      var value = field.value;
      inlineStatus(id, column, "saving …", "text-bg-secondary");
      // keepalive: the save completes even if the user leaves the page right away
      inlineSaves[key] = fetch(form.action, {
        method: "POST",
        keepalive: true,
        headers: { "X-Requested-With": "XMLHttpRequest", "Accept": "application/json" },
        body: new URLSearchParams(new FormData(form))
      }).then(function (res) {
        if (!res.ok) throw new Error("HTTP " + res.status);
        oldField.value = value;
        inlineStatus(id, column, "saved", "text-bg-success");
        if (close) closeInlineEditor(id, column);
      }).catch(function (err) {
        console.error(err);
        inlineStatus(id, column, "not saved – please reload the page", "text-bg-danger");
      }).finally(function () {
        delete inlineSaves[key];
      });
      return inlineSaves[key];
    }

    function cancelInlineEditor(id, column) {
      if (!column) column = "";
      document.getElementById(column + "markdown" + id).value = document.getElementById(column + "oldMarkdown" + id).value;
      onchangeMarkdown(id, column);
      closeInlineEditor(id, column);
    }


    function convert(text) {
      

      // generate the OSMBlog Style List
      if (text.substring(0, 2) == "* ") text = text.substring(2, 999999);
      // convert md to html
      text = window.mdRender.render(text);
      // skip <ul> and </ul> at start and end


      text = '<li>' + text + '</li>';


      return text;

    }
    function onchangeMarkdown(id,column) {
      if (!column) column="";
      var markdownField = document.getElementById(column + "markdown" + id);
      var md = markdownField.value;
      var pv = document.getElementById(column+"preview"+id);


      pv.innerHTML = convert(md);
      $(pv).trigger("change");

    }

    // vote labels (voteLabel in mixins.pug)
    $(document).on("click", ".osmbc-vote-label[data-call]", function (event) {
      event.preventDefault();
      callAndRedraw(this.dataset.call, this.dataset.redraw);
    });

    function callAndRedraw(call, redraw) {
      $.get("!{layout.htmlroot}" + call, function (data) {
        let j = $.getJSON("!{layout.htmlroot}" + redraw, function (json) {
          for (k in json) {
            var el = document.createElement("div");

            el.innerHTML = json[k];

            $(k).replaceWith(el.children[0]);
            el.remove();

          }
        });
      });

    }

    function translate(langFrom, langTo, service) {
      $(".translate" + langFrom + langTo).addClass("d-none");
      $(".translateWait" + langFrom + langTo).removeClass("d-none");
      var from =  langFrom.toLowerCase();
      var to = langTo.toLowerCase();

      let url =window.htmlroot + "/blog/!{blog.name}/translate/" + service + "/" + from + "/" + to;



      jQuery.post(window.htmlroot + "/blog/!{blog.name}/translate/" + service + "/" + from + "/" + to, function (data) {
        location.reload();
      }).fail(function (err) {
        console.error("Translation failed");
        console.error(err);
        $(".translateWait" + langFrom + langTo).addClass("d-none");
        $(".translateError" + langFrom + langTo).removeClass("d-none");
      });
    } 
        
    // review comments (blogheader.pug): edit an own comment, Review only with
    // a text, stop the personal review
    $(document).on("click", "[data-edit-review]", function () {
      const key = this.dataset.editReview;
      document.getElementById("editReview" + key).classList.remove("d-none");
      document.getElementById("reviewLeftText" + key).classList.add("d-none");
      fitToContentIn("#editReview" + key);
    });
    $(document).on("input", "[data-review-text]", function () {
      document.getElementById("reviewButton" + this.dataset.reviewText).disabled = (this.value === "");
    });
    $(document).on("click", "[data-review-stop]", function () {
      const lang = this.dataset.reviewStop;
      document.getElementById("reviewComment" + lang).value = "delete";
      document.getElementById("review" + lang).submit();
    });

    // status buttons of a language (blogReviewButtons); Close and Did Export
    // ask first
    $(document).on("click", "[data-lang-status]", function () {
      const button = $(this);
      if (button.data("confirm") && !window.confirm(button.data("confirm"))) return;
      button.prop("disabled", true);
      button.text("wait ...");
      jQuery.post(window.htmlroot + "/blog/!{blog.name}/setLangStatus", { action: button.data("lang-status"), lang: button.data("lang") }, function () {
        location.reload();
      }).fail(function (err) {
        console.error("Trouble setting Language Status");
        console.error(err);
      });
    });
