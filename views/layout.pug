include mixins


mixin firstBlogOfList(list,count,c)
  - if (!count) count = 1
  if (layout && layout.user && layout.user.hasFullAccess())
    if (list.length > 0)
      each blog,i in list
        if i<count
          li.navbar-item.active
            a.nav-link(href=`${layout.htmlroot}/blog/${blog.name}`)=blog.name
              span.badge.rounded-pill.osmbc-badge-lang=blogNumberNotFormulated(blog, layout.user.getLang(0))
              if layout.user.getLang(1)
                span.badge.rounded-pill.osmbc-badge-lang2=blogNumberNotFormulated(blog, layout.user.getLang(1))



mixin collectMenu
  li.navbar-item.active
    if (layout && layout.user && layout.user.hasFullAccess())
      a.nav-link#collect(href=htmlroot + '/article/create') Collect
    else
      a.nav-link#collect(href=htmlroot + '/article/create') Submit Link


mixin myGuestArticleMenu
  if (layout && layout.user && layout.user.access === "guest")
    li.navbar-item.active
      a.nav-link#myArticles(href=htmlroot + '/osmbc.html') My Articles 

mixin tbcMenu
  if (layout && layout.user && layout.user.hasFullAccess())
    li.navbar-item.active
      if blogNumberNotFormulated(layout.tbc, layout.user.getLang(0)) > 0
        - dynamicHide = ""
        if (layout.tbc._tbcOwnArticleNumber == 0)
          - dynamicHide = "d-none d-sm-flex"
        ul.nav.navbar-nav.me-auto(class=dynamicHide)
          li.nav-item
            a.nav-link(href=layout.htmlroot+'/blog/TBC')=layout.tbc.name
              if (layout.tbc._tbcOwnArticleNumber > 0)
                span.badge.rounded-pill.osmbc-badge-user=layout.tbc._tbcOwnArticleNumber

mixin inboxMenu
  if (layout && layout.user)
    li.navbar-item.active
      a.nav-link#inbox(href=layout.htmlroot + '/usert/inbox')="Inbox "
        if (layout.userMentions > 0)
          span.badge.rounded-pill.osmbc-badge-user=layout.userMentions
        if (layout.user.hasFullAccess())
          if (layout.mainLangMentions > 0)
            span.badge.rounded-pill.osmbc-badge-lang=layout.mainLangMentions
          if (layout.secondLangMentions > 0)
            span.badge.rounded-pill.osmbc-badge-lang2=layout.secondLangMentions

mixin articleMenu
  if (layout && layout.user && layout.user && layout.user.hasFullAccess())
    li.dropdown.nav-item.active
      a.nav-link.dropdown-toggle#articleMenuDropdown(href='#', data-bs-toggle='dropdown', role='button',aria-haspopup="true",aria-expanded="false") Search
      div.dropdown-menu(aria-labelledby="articleMenuDropdown")
        a.dropdown-header Articles
        a.dropdown-item#articleMenuSearch(href=layout.htmlroot + '/article/search') Search
        a.dropdown-item#articleMenuEmpty(href=layout.htmlroot + '/article/list?myArticles=true') My Empty Collections
        div.dropdown-divider
        a.dropdown-header Orphaned Article
        a.dropdown-item#articleMenuTrash(href=layout.htmlroot + '/article/list?blog=Trash') Trash
        a.dropdown-item#articleMenuTBC(href=layout.htmlroot + '/article/list?blog=TBC') TBC
        a.dropdown-item#articleMenuFuture(href=layout.htmlroot + '/article/list?blog=Future') Future
        a.dropdown-item#articleMenuNoBlog(href=layout.htmlroot + '/article/list?blog=') No Blog

mixin toolMenu
  if (layout && layout.user && layout.user.hasFullAccess())
    li.dropdown.nav-item.active
      a.nav-link.dropdown-toggle#toolsMenuDropdown(href='#', data-bs-toggle='dropdown', role='button',aria-haspopup="true",aria-expanded="false") Tools
      div.dropdown-menu(aria-labelledby="toolsMenuDropdown")
        if (layout.scriptUser === "full" || (Array.isArray(layout.scriptUser) && layout.scriptUser.indexOf(layout.user.OSMUser)>=0))
          div.dropdown-divider
          a.dropdown-header="Script Plugins (TEST PHASE)"
          a.dropdown-item(href=layout.htmlroot + "/tool/scripts/execute")="Execute Scripts"
          a.dropdown-item(href=layout.htmlroot + "/tool/scripts/log")="Script Results"

        div.dropdown-divider
        a.dropdown-header Editorial Tools
        a.dropdown-item(href="https://mattermost.openstreetmap.de") Mattermost for Editorial Team
        
        div.dropdown-divider
        a.dropdown-header About The Team
        a.dropdown-item(href="https://docs.google.com/spreadsheets/d/1LAoVqxf3GkE3a-P6zmrT7_D-Q7SMIAFXoK4MizoMThM/edit?usp=sharing") Google List of Skills



//- Small screens (mobile mode, see routes/layout.js): the header shows where
//- the user is (the issue) and the one mobile language instead of the app name.
mixin mobileHeader
  - var contextBlog = (typeof blog !== "undefined" && blog && blog.name) ? blog.name : ((typeof article !== "undefined" && article && article.blog) ? article.blog : null)
  if contextBlog
    a.navbar-brand.me-auto.text-truncate(href=layout.htmlroot + "/blog/" + contextBlog)=contextBlog
  else
    +homeButton("navbar-brand me-auto")
  div.dropdown
    button.btn.badge.rounded-pill.osmbc-badge-lang.dropdown-toggle.fs-6#mobileLangMenu(type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Language you work in on this device")=layout.mobileLang
    ul.dropdown-menu.dropdown-menu-end(aria-labelledby="mobileLangMenu")
      each l in layout.mobileLanguages
        li
          a.dropdown-item(href="#" id="mobileLang_" + l class=(l === layout.mobileLang) ? "active" : "" onclick=`chooseMobileLanguage('${l}'); return false;`)=l

block all
  doctype html
  html(lang='en')
    head
      meta(charset='utf-8')
      meta(name='viewport', content='width=device-width, initial-scale=1')
      meta(name='description', content='')
      meta(name='author', content='')
      link(rel='icon', href='/favicon.ico')
      title=(layout)?layout.title:appName
      script(nonce=cspNonce).
        // Mobile mode = below Bootstrap's lg breakpoint, like the menu panel and
        // the save bar. The server reads the cookie; if it rendered the other
        // mode, reload once (not again if the cookie does not stick).
        (function () {
          var rendered = "#{(typeof layout !== "undefined" && layout && layout.mobileView) ? "mobile" : "desktop"}";
          var wanted = window.matchMedia("(max-width: 991.98px)").matches ? "mobile" : "desktop";
          if (document.cookie.indexOf("osmbc_view=" + wanted) < 0) {
            document.cookie = "osmbc_view=" + wanted + "; path=/; max-age=31536000; SameSite=Lax";
          }
          if (wanted === rendered || document.cookie.indexOf("osmbc_view=" + wanted) < 0) return;
          try {
            if (window.sessionStorage.getItem("osmbcViewReload") === location.href) return;
            window.sessionStorage.setItem("osmbcViewReload", location.href);
          } catch (e) { return; }
          location.reload();
        })();
      // Bootstrap core CSS
      link(href=layout.htmlroot + "/stylesheets/bootstrap.min.css?osmbc_v=" + layout.osmbc_version, rel='stylesheet')
      link(href=layout.htmlroot + "/stylesheets/bootstrap-select.min.css?osmbc_v=" + layout.osmbc_version, rel='stylesheet')
      link(href=layout.htmlroot + "/stylesheets/font-awesome.min.css?osmbc_v=" + layout.osmbc_version, rel='stylesheet')
      if (typeof stylesheet !== 'undefined' && stylesheet)
        link(rel='stylesheet', href=`${htmlroot}${stylesheet}?osmbc_v=${layout.osmbc_version}`)
      if (typeof extraStyle !== 'undefined' && extraStyle)
        link(rel='stylesheet', href=`${htmlroot}${extraStyle}?osmbc_v=${layout.osmbc_version}`)

    body
      - function blogNumberNotFormulated(blog,language) {return ((blog)?blog.getUnEdited(language):"?") }
      - function blogNumberAutoTranslate(blog,language) {return ((blog)?blog.getAutoTranslate(language):"?") }
      - function blogCount(blog,language) {return ((blog)?blog.getExpected(language):"?") }


      // Fixed navbar
      nav.navbar.navbar-light.bg-light.navbar-expand-lg.fixed-top#fixedNavbar
        div.container-fluid
          - var listall = []
          if (layout)
            - listall = [].concat(layout.listOfReviewBlog)
            - listall = listall.concat(layout.listOfEditBlog)
            - listall = listall.concat(layout.listOfOpenBlog)

          
          button.navbar-toggler(type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-label="Toggle navigation")
            span.navbar-toggler-icon
          if (layout && layout.mobileView)
            +mobileHeader
          else
            +homeButton("navbar-brand")  
          //- below lg the menu is a side panel (offcanvas), from lg on a normal menu bar
          div.offcanvas.offcanvas-end#navbarSupportedContent(tabindex="-1" aria-labelledby="navbarSupportedContentLabel")
            div.offcanvas-header
              h5.offcanvas-title#navbarSupportedContentLabel=appName
              button.btn-close(type="button" data-bs-dismiss="offcanvas" aria-label="Close")
            div.offcanvas-body.flex-grow-1
              ul.navbar-nav
                +collectMenu
                +inboxMenu
                
                +tbcMenu
                +myGuestArticleMenu
                +firstBlogOfList(listall,2)
                +articleMenu    
                +toolMenu
                block additionalMenuMain    
              ul.navbar-nav.ms-auto
                +helpMenu(layout.helpMenu)
                block additionalMenuRight
                +userAvatar


      .container-fluid
        if (layout && layout.user && layout.user && layout.user.emailInvalidation)
          p
            div.alert.alert-danger.text-center#mailalert
              span="Waiting for email verification, have a look at the email with the title '[OSMBC] Welcome to OSMBC' in your inbox."
              span
                | 
                a.alert-link(href=layout.htmlroot+"/usert/self")="Go to User Configuration"
        if (layout && layout.user && layout.user && !layout.user.email && !layout.user.emailInvalidation)
          p
            div.alert.alert-danger.text-center#mailalert
              span="Please enter your email to receive comments and feedback here:"
              span
                | 
                a.alert-link(href=layout.htmlroot + "/usert/self")="Go to User Configuration"

        p
         block content

      // /container

      // Bootstrap core JavaScript
      // ==================================================
      // Placed at the end of the document so the pages load faster
      script(src=layout.htmlroot + "/javascripts/jquery.min.js?osmbc_v=" + layout.osmbc_version)
      script(src=layout.htmlroot + "/javascripts/bootstrap.bundle.min.js?osmbc_v=" + layout.osmbc_version)
      script(src=layout.htmlroot + "/javascripts/bootstrap-select.min.js?osmbc_v=" + layout.osmbc_version)
      script(src=layout.htmlroot + "/javascripts/osmbc_staff.js?osmbc_v=" + layout.osmbc_version)

      script(nonce=cspNonce).

        // Init This Window with jQuery ready Callback
        window.htmlroot = "!{layout.htmlroot}";

      script(nonce=cspNonce).
        // keep the content below the fixed navbar, whatever its height
        (function () {
          // an adopted style sheet does not change the DOM (style.css has a fallback)
          var navbar = document.getElementById("fixedNavbar");
          if (window.CSSStyleSheet && document.adoptedStyleSheets && window.ResizeObserver) {
            var sheet = new CSSStyleSheet();
            document.adoptedStyleSheets = document.adoptedStyleSheets.concat([sheet]);
            var fit = function () { sheet.replaceSync("body { padding-top: " + navbar.offsetHeight + "px; } :root { --osmbc-navbar-height: " + navbar.offsetHeight + "px; }"); };
            fit();
            new ResizeObserver(fit).observe(navbar);
          }
          // small screens: hide the bar when scrolling down, show it when scrolling up
          var lastY = window.scrollY;
          window.addEventListener("scroll", function () {
            var y = window.scrollY;
            var hide = window.matchMedia("(max-width: 991.98px)").matches && y > lastY && y > navbar.offsetHeight;
            navbar.classList.toggle("osmbc-navbar-hidden", hide);
            lastY = y;
          }, { passive: true });
          // close the side panel after choosing an entry (also for script actions)
          var panel = document.getElementById("navbarSupportedContent");
          panel.addEventListener("click", function (event) {
            var entry = event.target.closest(".dropdown-item, .nav-link:not(.dropdown-toggle)");
            if (!entry) return;
            var instance = window.bootstrap.Offcanvas.getInstance(panel);
            if (instance) instance.hide();
          });
        })();

      block scripts_to_load 

      block scripts_to_execute
