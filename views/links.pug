extends adminlayout

//- Checked links (routes/link.js): last automatic check and editors' answers.
//- Search and filter are a plain GET form; the buttons use the delegated
//- handlers in osmbc_staff.js (the page reloads after a change).
mixin checkText(r)
  case r.state
    when "ok"
      | link check: ok
    when "broken"
      | link check: not found (#{r.status})
    when "blocked"
      | link check: can't be checked automatically (#{r.status})
    when "unreachable"
      | link check: temporarily unreachable (#{r.status})
    default
      | not checked yet

block content
  h1 Checked links
  p.text-muted
    | The link check stores its result for every link it sees. An editor can say whether a link exists,
    | in both directions; the answer wins over the link check while it is valid.
  form#linkFilter.d-flex.flex-wrap.align-items-end.gap-2.mb-3(method="get" action=layout.htmlroot + "/link")
    div.flex-grow-1
      label.form-label(for="linkSearch") Search url or user
      input.form-control#linkSearch(type="search" name="q" value=q)
    div
      label.form-label(for="linkFilterSelect") Show
      select.form-select#linkFilterSelect(name="filter")
        each f in filters
          option(value=f selected=(f === filter))= f
    button.btn.btn-primary(type="submit") Filter
  if links.length === 0
    p#noLinks No checked links.
  else
    p.text-muted.small
      if total > links.length
        | #{total} links, showing the last #{links.length}
      else
        | #{total} links
    ul.list-group#links
      each l in links
        - var r = l.result
        li.list-group-item.d-flex.flex-wrap.align-items-center.gap-2(data-link-row=l.url)
          if r.exists === true
            span.badge.text-bg-success exists
          else if r.exists === false
            span.badge.text-bg-danger missing
          else
            span.badge.text-bg-secondary open
          div.flex-grow-1.text-break
            a(href=l.url target="_blank" rel="noopener noreferrer")= l.url
            div.small.text-muted
              +checkText(r)
              if l.answer
                |  · #{l.answer.exists ? "exists" : "missing"}, said #{l.answer.by} on #{layout.moment(l.answer.timestamp).format("YYYY-MM-DD")}
                if l.expired
                  span.badge.text-bg-secondary.ms-2 expired #{layout.moment(l.answerValidUntil).format("YYYY-MM-DD")}
                else
                  |  · valid until #{layout.moment(l.answerValidUntil).format("YYYY-MM-DD")}
          div.d-flex.flex-wrap.gap-2
            if l.answer
              button.btn.btn-outline-secondary(type="button" data-link-revoke=l.url) Undo
            if !l.answer || l.expired
              if r.exists !== true
                button.btn.btn-outline-success(type="button" data-link-answer="true" data-link-url=l.url) Exists
              if r.exists !== false
                button.btn.btn-outline-danger(type="button" data-link-answer="false" data-link-url=l.url) Missing
