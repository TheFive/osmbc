extends adminlayout

//- within the coming week the weekday is enough, the date only from the next week on (or when past)
mixin upcomingTime(ts, tz)
  - var m = layout.moment(ts).tz(tz)
  - var days = m.clone().startOf("day").diff(layout.moment().tz(tz).startOf("day"), "days")
  - var text = (days === 0) ? m.format("[today] HH:mm z") : (days > 0 && days < 7) ? m.format("ddd HH:mm z") : m.format("ddd, YYYY-MM-DD HH:mm z")
  time(datetime=new Date(ts).toISOString(), data-localtime="", data-tz=tz)= text

block content
  .row
    .col-md-4
      h1="Configuration"
      h3="Calendar"
      
      p
        a(href=layout.htmlroot+"/config/calendartranslation")  Calendar Translation Texts
      p
        a(href=layout.htmlroot+"/config/calendarflags")  Flags for calendar
      p
        a(href=layout.htmlroot+"/config/eventsfilter")  Filter for calendar
      h3="Editor Info"
      p
        a(href=layout.htmlroot+"/config/formulation_tipDE")  Formulation Hint for DE
      p
        a(href=layout.htmlroot+"/config/formulation_tipEN")  Formulation Hint for EN
      p
        a(href=layout.htmlroot+"/config/categorydescription")  Descriptions for Categories
      p
        a(href=layout.htmlroot+"/config/languageflags") Language Indicator Icons
      p
        a(href=layout.htmlroot + "/config/helpmenu") Configure Help Menu
        
      h3="Pictures"
      p
        a(href=layout.htmlroot+"/config/licenses") Picture Licensing
      h3="Blog"
      p
        a(href=layout.htmlroot+"/config/editorstrings") Author Documentation
      p
        a(href=layout.htmlroot+"/config/categorytranslation") Category Translation
      p
        a(href=layout.htmlroot+"/config/newArticles") Empty Articles To Create
      h3="Article"
      p
        a(href=layout.htmlroot+"/config/automatictranslatetext") Text for Translate Links
      p
        a(href=layout.htmlroot+"/config/ignoreforsearch") Not a Doublette Link
      p
        a(href=layout.htmlroot+"/config/votes") Votes For Articles
      if layout.firstDraftVisible
        p
          a(href=layout.htmlroot+"/config/firstdraftprompt") First Draft Prompt (Claude)
      h3="IM Notification"
      p
        a(href=layout.htmlroot+"/config/slacknotification") Configuration of IM Channel (Slack,MM)

    .col-md-8
      div.d-none
        p
          br
          - var d = new Date();
          - d= d.toISOString();
          - d= d.substring(0,7);
          a(href=layout.htmlroot+"/changes/log?table=config&date="+d) [changes]
      if upcoming
        div#upcomingActions
          h4="Upcoming automatic actions"
          if !upcoming.enabled
            p="Automatic transitions are switched off (Transition.enabled)."
          else
            - var tz = upcoming.timezone
            table.table.table-sm
              thead
                tr
                  th Rule
                  th Blog
                  th When
                  th What
              tbody
                if !upcoming.autoEdit.enabled
                  tr
                    td Auto Edit
                    td(colspan=3) off
                else if upcoming.autoEdit.blogs.length === 0
                  tr
                    td Auto Edit
                    td(colspan=3) no open blog with end date
                else
                  each b in upcoming.autoEdit.blogs
                    tr
                      td Auto Edit
                      td= b.name
                      td
                        +upcomingTime(b.ts, tz)
                        if b.overdue
                          |  (overdue, next run)
                      td open → edit, a new blog is created if none is open
                if !upcoming.autoTranslate.enabled
                  tr
                    td Auto Translate
                    td(colspan=3) off
                else if upcoming.autoTranslate.problem
                  tr
                    td Auto Translate
                    td(colspan=3)= upcoming.autoTranslate.problem
                else if upcoming.autoTranslate.blogs.length === 0
                  tr
                    td Auto Translate
                    td(colspan=3) no blog due
                else
                  each b in upcoming.autoTranslate.blogs
                    tr
                      td Auto Translate
                      td= b.name
                      td
                        +upcomingTime(b.ts, tz)
                      td
                        div= "translate from " + upcoming.autoTranslate.sourceLanguage + ": " + (b.translate.join(", ") || "none")
                        if b.inactive.length > 0
                          div.text-muted= "skipped, not closed in the last " + upcoming.autoTranslate.previousBlogs + " blogs: " + b.inactive.join(", ")
                        if b.translated.length > 0
                          div.text-muted= "already auto translated: " + b.translated.join(", ")
                        if b.done.length > 0
                          div.text-muted= "already closed/exported: " + b.done.join(", ")
                if !upcoming.autoLanguageClose.enabled
                  tr
                    td Auto Close
                    td(colspan=3) off
                else if upcoming.autoLanguageClose.blogs.length === 0
                  tr
                    td Auto Close
                    td(colspan=3) no blog due
                else
                  each b in upcoming.autoLanguageClose.blogs
                    tr
                      td Auto Close
                      td= b.name
                      td
                        +upcomingTime(b.ts, tz)
                      td
                        - var minReviews = upcoming.autoLanguageClose.minReviews
                        div= minReviews + (minReviews === 1 ? " review" : " reviews") + " needed, close: " + (b.close.join(", ") || "none")
                        //- languages still waiting, grouped by their review count (most reviews first)
                        - for (var n = minReviews - 1; n >= 0; n--)
                          - var langs = b.waiting.filter((w) => w.reviews === n).map((w) => w.lang)
                          if langs.length > 0
                            div.text-muted= n + (n === 1 ? " review: " : " reviews: ") + langs.join(", ")
                        if b.done.length > 0
                          div.text-muted= "already closed/exported: " + b.done.join(", ")
      div
        h4="Long Absent"
        p
          table.table
            tr
              td
                for user,i in longAbsent
                  span
                    a(href=layout.htmlroot + "/usert/" + user.OSMUser)=user.OSMUser
                    span=", "
        if deeplUsage
          h4="DeeplUsage"
          p="Used Characters: " + deeplUsage.character_count
          p="Limit Characters: " + deeplUsage.character_limit
          p="Usage Percent: " + deeplUsage.character_percent
          
        if changes
          h4="Last Changes "
            - var d = new Date();
            - d= d.toISOString();
            - d= d.substring(0,7);
            a(href=layout.htmlroot+"/changes/log?date="+d)  (more)
          div
            table.table.table-striped.table-sm.table-responsive
              thead
                tr
                  th=""
                  th
                   | blog
                  th
                   | user
                  th
                   | table
                  th
                   | what
                  th
                   | Change
                  th
                   | when
              tbody
                each change, i in changes
                  tr
                    td
                      a(href=layout.htmlroot+'/changes/' + change.id)
                        i.fa.fa-info-circle
                    td= change.blog
                    td= change.user
                    td= change.table
                    td= change.property
                    td
                      |!{change.htmlDiffText(40)}
                    td= layout.moment(change.timestamp).fromNow()
          div
            p
              |only displaying changes
              span.osmbc-inserted
                |inserted text
              span.osmbc-deleted
                |removed text

  

  div.footer

block scripts_to_load
  script(src=layout.htmlroot + "/javascripts/localtime.js?osmbc_v=" + layout.osmbc_version)
