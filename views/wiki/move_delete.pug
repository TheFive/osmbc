extends ../layout
include wiki_mixins

block content
  .osmbc-wiki
    +wikiBreadcrumbs(breadcrumbs)
    form#wikiMoveDeleteForm(method="post" action=wikiBase + "/" + pageId)
      input(type="hidden" name="action" value=mode)
      input(type="hidden" name="baseBlob" value=blob)
      if mode === "move"
        h1.h4 Move #{title}
        .row
          .col-md-6.mb-3
            label.form-label(for="wikiMoveFolder") Folder
            select.form-select#wikiMoveFolder(name="folder")
              option(value="" selected=currentFolder === "") (top level)
              each folder in folders
                option(value=folder selected=folder === currentFolder)=folder
          .col-md-6.mb-3
            label.form-label(for="wikiMoveName") Page name
            input.form-control#wikiMoveName(type="text" name="name" value=currentName required)
        div.form-text.mb-3 a-z, 0-9, _ and -. For a new folder write it in front of the name: new_folder/page_name. Links to the old name are not changed.
      else
        h1.h4 Delete #{title}
        p The page is removed from the wiki. Its history stays, it can be restored from there.
      .mb-3
        label.form-label(for="wikiMessage") Reason (optional)
        input.form-control#wikiMessage(type="text" name="message" maxlength="200")
      div.d-flex.flex-wrap.gap-2.justify-content-end
        a.btn.btn-outline-secondary(href=wikiBase + "/" + pageId) Cancel
        if mode === "move"
          button.btn.btn-primary#wikiMoveSubmit(type="submit") Move
        else
          button.btn.btn-danger#wikiDeleteSubmit(type="submit") Delete
