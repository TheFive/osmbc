extends article



block markdownArea

  // Markdown Area All Column
  .row
    - languages = layout.user.getLanguages()
    if layout.user.getLanguageSet() === "Active"
      - languages = layout.activeLanguages
    //- small screens: one language only, the others are sources for Translate
    if layout.mobileView
      - languages = [layout.mobileLang]
    for lang of languages
      if (lang)
        div.col
          div.osmbc-language-column
            if layout.mobileView
              +mobileTranslateButtons(lang)
            +markdownWithPreview(lang)
    if layout.mobileView
      - const second = params.mobile_second_lang
      if second
        +mobileSecondLanguage(layout.mobileLang, second)
      +translationSources([layout.mobileLang, second])


  // Language Flags All Column

  //- phones: no flags (rare use), hidden not removed: the preview reads img.flag
  .row#languageFlags(class=layout.mobileView ? "d-none" : undefined)
    - for (lang in languageFlags)
      - if (["warning", "error", "emoji", "shortcut"].indexOf(lang) < 0)
        img.flag(id=lang,
          src=languageFlags[lang],
          class="img-thumbnail" ,
          width = 40,
          style="max-width: 40px; height: auto;",
          data-bs-toggle="tooltip" data-bs-placement="bottom" title=lang
          onclick="javascript:myclick(this.id)"
          ondragstart = "ondragstartflag(event,this.id);")
    p.osmbc-help-text="Click to copy to clipboard, or use drag and drop."
