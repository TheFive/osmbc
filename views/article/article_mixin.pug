extends ../layout


mixin leftcolumn
  if (params.right_lang === null)
    .col-md-10
      if block
        block
      else
        p No Content provided
  else
    .col-md-5
      if block
        block
      else
        p No Content provided

mixin rightcolumn
  if (params.right_lang !== null)
    .col-md-5
      if block
        block
      else
        p No Content provided
  else
    .col-md-5.d-none
      if block
        block
      else
        p No Content provided

mixin articleMarkdown(lang,disabled)
  - var d = disabled
  - var p=""
  - var isLangActive = layout.activeLanguages && layout.activeLanguages.includes(lang);
  if !isLangActive
    - p = "Language is currently inactive, to activate it just edit this text"
  else if placeholder.markdown[lang]
    - p = placeholder.markdown[lang];
  if (article.categoryEN === "Upcoming Events")
    - p = "Calendar will be generated from OSMCAL when starting review."  
  textarea.markdownEdit.form-control.af(id="markdown" +lang placeholder = p spellcheck = "true" lang=lang name = "markdown" +lang rows = 6 readonly = d)=article["markdown" + lang]
  p.osmbc-help-text="'no translation' or '-' to specify no translation wanted."
  if (!d && article.categoryEN === "Upcoming Events")
    div.btn.btn-info(onclick=`window.getEventTable("${lang}",${"markdown" + lang},this);`) (Re)Generate Calendar
  
  div.alert.markdownMessage.alert-danger(id="text"+lang lang=lang style="display:none" )="Default Error Message"


mixin articlePreview(lang)
  .card.card-body.preview(id="preview" + lang, lang = lang)
    |!{article["textHtml"+lang]}



mixin articleTextanalyse(lang)
  if (lang === "DE") && (article["markdown" + lang])
    a(href="#" class=layout.mobileView ? "osmbc-text-link" : undefined onClick ="taform = document.getElementById('textanalyseform');taf = document.getElementById('textanalysefield');taf.value = document.getElementById('previewDE').innerText; taf.parentElement.submit();") WORTLIGA Analyse (Aufruf einer externen Seite)

mixin articleTranslateButton(langFrom,langTo)
  if (article["markdown" + langFrom] && !article["markdown" + langTo] && article.isChangeAllowed("markdown" + langTo))
    button.btn.btn-primary(
         class="translate"+langFrom+langTo name = "translate"+langFrom+langTo
         onClick =`window.translate('${langFrom}','${langTo}',window.mainTranslationService);return false;`
       ) Translate #{langFrom} -> #{langTo}
    button.btn.btn-warning.d-none(class="translateWait"+langFrom+langTo)
      i.fa.fa-sync
      span=" Please Wait"
    button.btn.btn-danger.d-none(class="translateError"+langFrom+langTo)
      span="Error occured"



mixin saveButton
  button.btn.btn-lg.btn-primary#saveButton(type = "button" onclick ="window.saveButton()") Save

//- Small screens (one language): if that language is still empty, offer a
//- translation from every language that already has text, EN first (most
//- languages translate from English). Uses translate() in article_view.js.
mixin mobileTranslateButtons(lang)
  if (!article["markdown" + lang] && article.isChangeAllowed("markdown" + lang))
    - const sources = layout.languages.filter((l) => l !== lang && article["markdown" + l] && article["markdown" + l] !== "no translation")
    - sources.sort((a, b) => (a === "EN") ? -1 : (b === "EN") ? 1 : 0)
    - const services = layout.user.getTranslations().filter((service) => layout.user.useOneTranslation(service))
    if (sources.length > 0)
      div.d-flex.flex-wrap.gap-2.my-2
        if (services.length === 0)
          a.osmbc-help-text(href=layout.htmlroot + "/usert/" + layout.user.id)="Configure a translation service to translate from " + sources.join(", ")
        each source in sources
          each service in services
            button.btn.btn-outline-primary(type="button" class="translate" + source + lang onmousedown="event.preventDefault();" onclick=`window.translate('${source}','${lang}','${service}');`)
              ="Translate from " + source + ((services.length > 1) ? " (" + service + ")" : "")
          span.badge.text-bg-warning.d-none(class="translateWait" + source + lang)="please wait …"
          span.badge.text-bg-danger.d-none(class="translateError" + source + lang)="translation from " + source + " failed"
          each service in services
            span.badge.text-bg-success.d-none(class="translateDone" + source + lang + " " + service)="translated from " + source

//- Small screens: First Draft at the empty text field, one button per
//- collected url (like Translate, the menu is desktop only). Click handling
//- and status: firstDraft() in article_view.js.
mixin mobileFirstDraftButtons(lang)
  if (layout.firstDraftVisible && firstDraftUrls && firstDraftUrls.length > 0 && !article["markdown" + lang] && article.isChangeAllowed("markdown" + lang))
    div.d-flex.flex-wrap.gap-2.my-2
      each url in firstDraftUrls
        - let shortUrl = url.replace(/^https?:\/\/(www\.)?/, "")
        - if (shortUrl.length > 30) shortUrl = shortUrl.substring(0, 27) + "..."
        button.btn.btn-outline-primary.firstDraftItem.text-start(type="button" data-lang=lang data-url=url title=url)
          span.firstDraftLabel="First Draft "
          small=shortUrl
          span.ms-1.firstDraftWait.d-none
            i.fa.fa-spinner.fa-spin
          span.ms-1.firstDraftDone.d-none
            i.fa.fa-check
          span.ms-1.firstDraftError.d-none.text-danger
            i.fa.fa-times

//- Small screens: the second language of the desktop pair on demand,
//- below the mobile language and editable (X11). "Translate → second" shows
//- it and translates in one tap; article_view.js shows the button while the
//- mobile language has text and the second one is empty.
mixin mobileSecondLanguage(lang, second)
  - const services = layout.user.getTranslations().filter((service) => layout.user.useOneTranslation(service))
  - const canTranslate = services.length > 0 && article.isChangeAllowed("markdown" + second)
  div.d-flex.flex-wrap.gap-2.my-2.w-100
    //- onmousedown keeps the focus in the text field: losing it resizes the
    //- field (FitToContent) and moves the button away before the tap ends
    button.btn.btn-outline-secondary#toggleSecondLang(type="button" data-lang=second onmousedown="event.preventDefault();")="Show " + second
    if canTranslate
      button.btn.btn-outline-primary.d-none#translateToSecondLang(type="button" data-from=lang data-to=second data-service=services[0] onmousedown="event.preventDefault();")="Translate → " + second
  div.col-12.d-none#secondLanguage
    div.osmbc-language-column
      +mobileFirstDraftButtons(second)
      +mobileTranslateButtons(second)
      +markdownWithPreview(second)

//- Texts of the other languages for Translate on small screens: hidden and
//- disabled, so they are never submitted with the form.
mixin translationSources(shown)
  each source in layout.languages
    if (shown.indexOf(source) < 0 && article["markdown" + source])
      textarea.d-none(id="markdown" + source disabled)=article["markdown" + source]
      div.d-none(id="preview" + source)=article["markdown" + source]

//- Below lg (phones, and the "desktop view" of phone browsers) Save and
//- last Version sit in a bar at the bottom of the screen, wherever the user
//- is editing. It appears only when something is changed (showModified in
//- article_view.js, which also handles the buttons). Save is the widest
//- button, on the right under the thumb.
mixin saveBar
  div.d-lg-none
    div.osmbc-save-bar.fixed-bottom.bg-light.border-top.px-3.py-2.d-flex.d-none.gap-2
      button.btn.btn-outline-secondary#cancelButtonBar(type = "button" data-href=`${layout.htmlroot}/article/${article.id}?edit=false`) last Version
      button.btn.btn-primary.flex-grow-1#saveButtonBar(type = "button") Save
    //- room for the bar below the last content
    div.osmbc-save-bar-spacer.d-none(style="height: 4rem;")

mixin doublettesButton
  if articleReferences.count >= 1
    a(href="#doublettes")
      div.button.btn.btn-lg.btn-danger.mb-2=articleReferences.count + " doub."



mixin cancelButton
  button.btn.btn-lg.btn-secondary#cancelButton(type = "button" onclick =`disableUnchanged(); location.href='${layout.htmlroot}/article/${article.id}?edit=false';`) last Version


mixin noTranslationButton
  div#notranslationArea
    - open = false
    each lang in layout.activeLanguages
      if (article["markdown" + lang] || !article.isChangeAllowed("markdown" + lang))
      else
        - open = true;
    if open
      p.mt-2
        button.btn.btn-secondary#noTranslationButton(type = "button" onclick =" window.setNoTranslation(); ") no translation to rest

mixin markdownWithPreview(lang)
  - labelClass = ""
  - if (params.left_lang === lang) labelClass = "osmbc-label-lang";
  - if (params.right_lang === lang) labelClass = "osmbc-label-lang2";
  span.badge.text-bg-secondary(class=labelClass)="  " + lang + "  "
  span.badge.text-bg-danger(style="display:none" id="markdown" + lang + "_unsaved" )="unsaved"


  textarea.d-none.form-control(id="old_markdown" + lang, name="old_markdown" + lang,rows=1,hide=true)=article["markdown" + lang]
  +articleMarkdown(lang,!article.isChangeAllowed("markdown" + lang))
  +articlePreview(lang)
  +articleTextanalyse(lang)

mixin articleTranslateMenu(langFrom,langTo,service)
  if (article["markdown" + langFrom] && !article["markdown" + langTo] && article.isChangeAllowed("markdown" + langTo))
    a.dropdown-item(
        class="translate" + langFrom + langTo name = "translate" + langFrom + langTo
        onClick =`window.translate('${langFrom}',${JSON.stringify(langTo)},'${service}');return false;`
        )="Translate " + langFrom +  "->" + langTo
    a.dropdown-item.bg-warning.d-none(class="translateWait" + langFrom + langTo)=" Please Wait"
    a.dropdown-item.bg-danger.d-none(class="translateError" + langFrom + langTo)="Translate " + langFrom+  "->" +langTo +" "
        i.fa.fa-times
    a.dropdown-item.d-none(class="translateDone" + langFrom + langTo+" "+service)="Translate " + langFrom+  "->" +langTo +" "
       i.fa.fa-check


mixin translationMenu
  //- small screens: Translate buttons at the text field replace this menu
  if !layout.mobileView
    - let emptyMenu = true
    li.dropdown.navbar-item#translation.d-none.d-sm-block
      a.nav-link.dropdown-toggle#articleTranslateMenu(href='#', data-bs-toggle='dropdown',role='button',aria-haspopup="true",aria-expanded="false") Translate
      ul.dropdown-menu#articleTranslationDropdown(aria-labelledby="articleTranslateMenu" style="overflow-y: auto;")
        - let tsList = layout.user.getTranslations()
        each tService in tsList
          - emptyMenu = false
          li.dropdown-header="Use " + tService +":"
            - list = []
            - for ( i=0;layout.user.getLang(i);i++) {list.push(layout.user.getLang(i));}
            - let nothingToTranslate = true
            each a in list
              - all = []
              each b in list
                if (a !== b && a !== null && b !== null)
                  if (article["markdown" + a] && !article["markdown" + b] && article.isChangeAllowed("markdown" + b))
                    - all.push(b);
                    if (layout.user.useOneTranslation(tService))
                      +articleTranslateMenu(a, b, tService)
              if (layout.manyTranslationEnabled)
                if (all.length > 1)
                  if (layout.user.useManyTranslation(tService))  
                    +articleTranslateMenu(a, all, tService)
                


        .dropdown-divider
        a.dropdown-item(
          onclick="location.href='" + layout.htmlroot + "/usert/" + layout.user.id + "';"
        )="Configure your Translation services"
        




mixin firstDraftMenu
  //- First Draft: one entry per displayed, empty language markdown and collected url
  //- small screens: First Draft buttons at the text field replace this menu
  if (!layout.mobileView && layout.firstDraftVisible && firstDraftUrls && firstDraftUrls.length > 0)
    - let fdLanguages = layout.user.getLanguages()
    - if (layout.user.getLanguageSet() === "Active") fdLanguages = layout.activeLanguages
    - fdLanguages = fdLanguages.filter((l) => l && !article["markdown" + l] && article.isChangeAllowed("markdown" + l))
    if (fdLanguages.length > 0)
      li.dropdown.navbar-item#firstDraft.d-none.d-sm-block
        a.nav-link.dropdown-toggle#articleFirstDraftMenu(href='#', data-bs-toggle='dropdown',role='button',aria-haspopup="true",aria-expanded="false") First Draft
        ul.dropdown-menu#articleFirstDraftDropdown(aria-labelledby="articleFirstDraftMenu" style="overflow-y: auto;")
          each lang in fdLanguages
            each url in firstDraftUrls
              - let shortUrl = url.replace(/^https?:\/\/(www\.)?/, "")
              - if (shortUrl.length > 50) shortUrl = shortUrl.substring(0, 47) + "..."
              li
                a.dropdown-item.firstDraftItem(href="#" data-lang=lang data-url=url title=url)
                  span.firstDraftLabel=lang + " -> "
                  small.text-body-secondary=shortUrl
                  span.ms-1.firstDraftWait.d-none
                    i.fa.fa-spinner.fa-spin
                  span.ms-1.firstDraftDone.d-none
                    i.fa.fa-check
                  span.ms-1.firstDraftError.d-none.text-danger
                    i.fa.fa-times


block append scripts_to_load
  script(src=layout.htmlroot + "/javascripts/markdown-it.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/markdown-it-emoji.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/markdown-it-sup.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/markdown-it-imsize.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/markdown-it-link-attributes.min.js?osmbc_v=" + layout.osmbc_version)
  script(src=layout.htmlroot + "/javascripts/article_view.js?osmbc_v=" + layout.osmbc_version)



block append scripts_to_execute
  script(nonce=cspNonce).
    // set Constant for Window with JADE Variables
    googleTranslateText = JSON.parse('!{JSON.stringify(googleTranslateText)}');
    activeLanguages = JSON.parse('!{JSON.stringify(layout.activeLanguages)}');
    emojiShortcut = JSON.parse(decodeURIComponent(window.atob(`!{btoa(encodeURIComponent(JSON.stringify(languageFlags.shortcut)))}`)));
    emojiList =     JSON.parse(decodeURIComponent(window.atob(`!{btoa(encodeURIComponent(JSON.stringify(languageFlags.emoji)))}`)));
    linkAttributes = JSON.parse(decodeURIComponent(window.atob(`!{btoa(encodeURIComponent(JSON.stringify(linkAttributes)))}`)));
    userLanguages =  JSON.parse('!{JSON.stringify(layout.user.langArray)}');
    blogStartDate = '!{ (blog) ? blog.startDate : new Date().toISOString()}'
    translationServices = JSON.parse('!{JSON.stringify(translationServices)}');
    urlWoErrorWhileEdit = JSON.parse('!{JSON.stringify(urlWoErrorWhileEdit)}');
    mainTranslationService = "!{mainTranslationService}";
    placeholder = !{JSON.stringify(placeholder.categories)}
    var catArray = !{JSON.stringify(categories)};
    var articleReferences = !{JSON.stringify(articleReferences)};
    var noCategorie = "no categorie";
    if (catArray && catArray[0] && catArray[0].EN) noCategorie = catArray[0].EN;
    jQuery('#translation').on('show.bs.dropdown', function () {
      jQuery('#articleTranslationDropdown').css('max-height', ($(window).height() - $('#articleTranslationDropdown').offset().top) -$('#fixedNavbar').height() + 'px');
    })

