extends adminlayout




mixin userListPaging(paging)
  //- previous / next page; buttons (tap targets) in a wrapping row
  if paging.pages > 1
    div.d-flex.flex-wrap.gap-2.align-items-center.my-2
      if paging.previousUrl
        a.btn.btn-outline-secondary#previousPage(href=paging.previousUrl) « Previous
      span="Page " + paging.page + " of " + paging.pages + " (" + paging.total + " users)"
      if paging.nextUrl
        a.btn.btn-outline-secondary#nextPage(href=paging.nextUrl) Next »

block content

  row
    div
      //- search within the chosen list (filters and sort order stay)
      form#userSearch.d-flex.flex-wrap.align-items-end.gap-2.my-2(method="get" action=layout.htmlroot + "/usert/list")
        each param in keptParams
          input(type="hidden" name=param[0] value=param[1])
        div.flex-grow-1
          label.form-label(for="userSearchText") Search OSM name, author name or Mattermost name
          input.form-control#userSearchText(type="search" name="search" value=search maxlength="100")
        button.btn.btn-primary#userSearchButton(type="submit") Search
      if search !== "" && paging.pages <= 1
        p#userSearchCount=paging.total + (paging.total === 1 ? " user found" : " users found")
      +userListPaging(paging)
      table.table.table-striped.table-responsive
        thead
          tr
            th="color"
            th
              a(href=sortUrl("OSMUser")) Name
            th="OSM"
            th
              a(id="sortWeeklyAuthor" href=sortUrl("mdWeeklyAuthor")) WeeklyAuthor
            th
              a(id="sortOSMBCChanges" href=sortUrl("OSMBC-changes"))="OSMBC Changes"
            th
              | Email
            th
              | Collection
            th
              | AllComment
            th
              | Comment
            th
              | Status
            th
              a(href=sortUrl("language")) Language
            th
              | access
            th
              a(href=sortUrl("lastAccess", true)) lastAccess

        tbody
          each user in users
            tr
              td
                span.badge.osmbc-label-collect(style="background-color:" + user.color)=user.OSMUser

              td
                if (user.OSMUser  && user.OSMUser != '')
                  a(href=layout.htmlroot+'/usert/' + user.id)=user.OSMUser
                else
                  a(href=layout.htmlroot+'/usert/' + user.id) Missing Name
              td
                 a(href='http://www.openstreetmap.org/user/' + user.OSMUser) [OSM]
              td
                if user.mdWeeklyAuthor

                  |!{layout.md_renderInline(user.mdWeeklyAuthor)}
              td
                a(href=layout.htmlroot+'/changes/log?user=' + user.OSMUser) (#{user._countChanges})
              td
                if user.email
                  i.fa.fa-check
                else if user.emailInvalidation
                  i.fa.fa-question-circle
              td
                if user._notifiesNewCollection && user.email
                  i.fa.fa-check
                else
                  p=" "
              td
                if user.mailAllComment==="true" && user.email
                  i.fa.fa-check
                else
                  p=" "
              td= (user.email)?user.mailComment:""
              td= (user.email)?user.mailBlogLanguageStatusChange:""



              td= user.language
              td= user.access
              if (user.lastAccess)
                td= layout.moment(user.lastAccess).fromNow()
              else 
                td
                  | Never



  
      +userListPaging(paging)
