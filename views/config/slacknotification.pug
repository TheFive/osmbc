extends config



block showContentOfConfig
  if config.json
    table#resulttable.table.table-striped.table-responsive
      thead
        tr
          th="Slack"
          th="Channel"
          th="New Submissions"
          th="Changed Collections"
          th="Guest Texts"
          th="All Comments"
          th="Comments"
          th="Blog Change"
          th="Blog Language Change"
        tr
          td.text-info="osmde / theweeklyosm"
          td.text-info="#channelname"
          td.text-info="true / editor / guest / false"
          td.text-info="true / editor / guest / false"
          td.text-info="true / false"
          td.text-info="true / false"
          td.text-info="List of languages in []"
          td.text-info="true / false"
          td.text-info="List of languages in []"
      tbody

        each c in config.json
          if c
            tr
              td=c.slack
              if c.channel && c.channel.substring(0,1)==="#"
                td=c.channel
              else
                td.danger=c.channel

              td=c.notifyNewCollection
              //- missing: follows notifyNewCollection (issue #1170)
              if (typeof c.notifyCollectionChange === "undefined")
                td.text-body-secondary="(as New Submissions)"
              else
                td=c.notifyCollectionChange
              td=c.notifyGuestTextChange
              td=c.notifyAllComment
              td
                if c.notifyComment
                  for t in c.notifyComment
                    span='"'+t+'"'
                    span=" "
              td=c.notifyBlogStatusChange
              td
                if c.notifyBlogLanguageStatusChange
                  for t in c.notifyBlogLanguageStatusChange
                    span='"' + t + '"'
                    span=" "
          else
            tr
              td.danger(colspan="9")="(invalid entry)"



