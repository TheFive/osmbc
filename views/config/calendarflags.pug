extends config

block showContentOfConfig
  h2= "Flag Preview"
  if config.json
    - all = [];i=0;
    for val,key in config.json
      if (key === "emoji")
        - break
      if (key === "shortcut")
        - break
      - all[i]= {val:val,key:key}
      - i++

    -
      function isImagePath(v) {
        if (!v) return false;
        return v.substr(0,8) === "https://" || v.substr(0,7) === "http://" || v.substr(0,1) === "/";
      }
      function resolveImageSrc(v) {
        if (v.substr(0,8) === "https://" || v.substr(0,7) === "http://") return v;
        if (v.substr(0,12) === "/wp-uploads/") return "https://weeklyosm.eu/wp-content/uploads/" + v.substr(12);
        return "https://weeklyosm.eu" + v;
      }

    - for (i =0;i*6<=(all.length);i++)
      .row
        - for (j=i*6;j<Math.min(all.length,(i+1)*6);j++)
          .col-sm-2
            span=all[j].key
            if (isImagePath(all[j].val))
              img(src= resolveImageSrc(all[j].val), class="img-thumbnail" ,width = 30)
            else
              span=all[j].val
    
    
    if (config.json.emoji)
      h2="Emoji´s Preview"
      .row
        for val, key in config.json.emoji 
          .col-sm-1
            span=":" + key + ":"
            span=" "
            span
              |!{val}
    if (config.json.shortcut && config.json.emoji)
      h2="Allowed Shortcut´s"
      .row
        for val, key in config.json.shortcut 
          .col-sm-1
            span
              |!{config.json.emoji[key]}
            span=" "
            for v in val
              span=" " + v + " "
    if (config.json.error) 
      h2="Error"
      ul
        for v in config.json.error
          li.text-danger=v
    
        
        

